{
  "expo": {
    "name": "wakajob",
    "slug": "wakajob-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#1972ca"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "allowBackup": false,
      "package": "com.tamanjong.wakajobApp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-mark.png",
          "resizeMode": "contain",
          "backgroundColor": "#1972ca"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon-mark.png",
          "color": "#1972ca",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-task-manager",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "933f23a8-6b54-4d7a-8084-74c30601b2e2"
      }
    },
    "owner": "tamanjong",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/933f23a8-6b54-4d7a-8084-74c30601b2e2"
    }
  }
}
